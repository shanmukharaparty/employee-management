pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }

    environment {
        APP_NAME = 'employee-management'
        VERSION = '1.0.0'
        WAR_FILE = 'target/employee-management.war'

        NEXUS_URL = 'http://YOUR-NEXUS-SERVER:8081'
        NEXUS_REPOSITORY = 'maven-releases'

        TOMCAT_URL = 'http://YOUR-TOMCAT-SERVER:8080'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        mvn sonar:sonar \
                          -Dsonar.projectKey=employee-management \
                          -Dsonar.projectName=employee-management
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package WAR') {
            steps {
                sh 'mvn package -DskipTests'
                archiveArtifacts artifacts: 'target/*.war', fingerprint: true
            }
        }

        stage('Upload to Nexus') {
            steps {
                echo 'Configure Nexus credentials and upload the WAR here.'
                echo "WAR generated: ${WAR_FILE}"
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                echo 'Configure Tomcat credentials and deploy the WAR here.'
                echo "Target Tomcat: ${TOMCAT_URL}"
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Run application health check after deployment.'
                echo "Expected URL: ${TOMCAT_URL}/employee-management/health"
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'CI/CD pipeline failed. Check the Jenkins console output.'
        }

        always {
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
        }
    }
}
